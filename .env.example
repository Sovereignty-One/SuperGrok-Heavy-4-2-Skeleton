# SuperGrok Environment Configuration
# Copy to .env and fill in your values
# No Google · No Meta · 127.0.0.1 Only · a-shell / iSH compatible

# Keycloak (SSO / Identity Provider)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=sovereignty
KEYCLOAK_CLIENT_ID=sovereignty-app

# GitHub OAuth (optional; only needed for gh_oauth / gh_exchange flow)
# GH_CLIENT_ID=
# GH_CLIENT_SECRET=

# Server - UNIFIED PORT ARCHITECTURE
# Python bridge stays on 9897; Node.js bridge uses 9899 to avoid conflict.
# If PORT_BRIDGE matches PORT_UNIFIED (default), the proxy listener is skipped automatically.
PORT_UNIFIED=9899
PORT_BRIDGE=9899
PORT_AUTH=9899

# Logging
LOG_DIR=./logs
VERBOSE=0

# TTS — Piper (local binary)
# PIPER_BIN=./piper
# PIPER_MODEL=./en_US-lessac-medium.onnx

# TTS — Coqui (HTTP server, start with: python coqui_tts_service.py --serve)
COQUI_URL=http://localhost:5002

# AI API Keys (set at least one for AI features)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# XAI_API_KEY=xai-...

# Database (if applicable)
# POSTGRES_PASSWORD=
# DATABASE_URL=

# Secret Key (auto-generated if not set)
# SECRET_KEY=
