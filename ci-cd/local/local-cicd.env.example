ENABLE_DEPLOY=0
ENABLE_EXPORT_ARCHIVE=0
ENABLE_MIRROR_PUSH=0

# Explicit execution mode: offline, hybrid, or online.
# On self-hosted Linux, unset SG_MODE defaults to hybrid.
SG_MODE=hybrid

# Mirror pushes require both ENABLE_MIRROR_PUSH=1 and CONFIRM_MIRROR_PUSH=YES.
CONFIRM_MIRROR_PUSH=

EXPORT_URL=http://127.0.0.1:9899/compliance/export
EXPORT_RETENTION=10
EXPORT_DIR=

TARGET_REMOTE_NAME=sovereignty-ai-studio
TARGET_REPO_URL=git@github.com:Appel420/Sovereignty-AI-Studio.git
TARGET_BRANCH=

WAIT_RETRIES=30
WAIT_SECONDS=2
