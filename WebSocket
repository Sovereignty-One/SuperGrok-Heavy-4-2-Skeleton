<script type="module">
import init, { hash as blake3Hash } from 'https://cdn.jsdelivr.net/npm/blake3-wasm@2.1.5/blake3_wasm.js';

let blake3Ready = false;
let hashCancel = false;
try {
  await init();
  blake3Ready = true;
  document.getElementById('blake3Status').innerText = ‘BLAKE3 WASM Loaded ✓';
} catch (e) {
  document.getElementById('blake3Status').innerText = ‘BLAKE3 WASM failed to load ✗';
}

window.showTab = function(tabId) {
	⁃	  document.querySelectorAll('.tabs').forEach(tab => tab.classList.remove('active'));
  document.getElementById(tabId).classList.add('active');
};

document.getElementById('toggleSidebar').onclick = function() {
  document.getElementById('sidebar').classList.toggle('collapsed');
};

window.cancelHash = function() {
  hashCancel = true;
  document.getElementById('hashProgress').classList.add('cancelled');
}

window.computeHash = async function(){
  const algo = document.getElementById('hashAlgo').value;
  const input = document.getElementById('hashInput').value;
  const progress = document.getElementById('hashProgress');
}
  const output = document.getElementById('hashOutput');
  const chunksDiv = document.getElementById('hashChunks');
	⁃	  hashCancel = false;
  progress.classList.remove('cancelled');
  progress.style.display =‘block’;
  progress.value = 0;
  output.innerText = '';
	⁃	  chunksDiv.innerText = '';
	⁃	
  if(algo === ‘SHA3’){
    const enc = new TextEncoder();
	⁃	    const data = enc.encode(input);
    const hashBuf = await crypto.subtle.digest('SHA-512', data);
    output.innerText = Array.from(new Uint8Array(hashBuf)).map(x => x.toString(16).padStart(2, '0')).join('');
	⁃	  } else if(algo === ‘BLAKE3’ && blake3Ready){
	⁃	    const enc = new TextEncoder();
	⁃	    const data = enc.encode(input);
	⁃	    let chunkSize = Math.max(Math.floor(data.length / 10), 1);
	⁃	    let combined = [];
	⁃	    for(let i=0;i<data.length;i+=chunkSize){
	⁃	      if(hashCancel){ output.innerText+='\nHash canceled'; break; }
	⁃	      const chunk=data.slice(0,i+chunkSize);
      const partialHash=blake3Hash(chunk).toString('hex');
      combined.push(partialHash.slice(0,8)+'...');
      chunksDiv.innerText = combined.join('\n');
      chunksDiv.scrollTop = chunksDiv.scrollHeight;
      progress.value = Math.min(100, (i + chunkSize) / data.length * 100);
      await new Promise(r => setTimeout(r, 50));
    }
    if (!hashCancel) {
      output.innerText = blake3Hash(data).toString('hex');
    }
  } else {
    output.innerText='BLAKE3 WASM not ready';
  }
  progress.style.display =‘none’;
}

window.runBenchmark = function(){
	⁃	  const ctx = document.getElementById('benchChart').getContext('2d');
  const tooltip = document.getElementById('tooltip');
	⁃	  const data = [];
	⁃	  for (let i = 0; i < 5; i++) {
	⁃	    const start = performance.now();
	⁃	    for (let j = 0; j < 1e5; j++) {}
	⁃	    const duration = (performance.now() - start).toFixed(2);
	⁃	    data.push(duration);
	⁃	  }
	⁃	  document.getElementById('benchOutput').innerText='Benchmark results (ms): ‘ + data.join(', ');
	⁃	
	⁃	  ctx.clearRect(0,0,400,200);
	⁃	  const barWidth = 40;
	⁃	  let currentHeight = Array(data.length).fill(0);
	⁃	  const maxHeight = 160;
	⁃	  const axisOffset = 30;
	⁃	  const maxVal = Math.max(...data.map(Number));
	⁃	  let tickProgress = 0;
	⁃	
	⁃	  function animate() {
	⁃	    ctx.clearRect(0,0,400,200);
	⁃	    ctx.font='12px Arial';
	⁃	    ctx.strokeStyle = '#000';
	⁃	
	⁃	    ctx.beginPath();
	⁃	    ctx.moveTo(axisOffset, 0);
	⁃	    ctx.lineTo(axisOffset, 200);
	⁃	    ctx.lineTo(400, 200);
	⁃	    ctx.stroke();
	⁃	
	⁃	    for (let i = 0; i <= 5; i++) {
	⁃	      let y = 200-(i * 160 / 5);
	⁃	      const slideOffset = (1 - tickProgress) * 10;
	⁃	      ctx.globalAlpha = tickProgress;
	⁃	      ctx.fillText(Math.round(maxVal * (i / 5)), 0 + slideOffset, y);
	⁃	      ctx.globalAlpha = 1;
	⁃	      ctx.beginPath();
	⁃	      ctx.moveTo(axisOffset - 5+ slideOffset, y);
	⁃	      ctx.lineTo(axisOffset + slideOffset, y);
	⁃	      ctx.stroke();
	⁃	    }
	⁃	
	⁃	    let done = true;
	⁃	    for (let i = 0; i < data.length; i++) {
	⁃	      const targetHeight = (data[i] / maxVal) * maxHeight;
	⁃	      if (currentHeight[i] < targetHeight) {
	⁃	        currentHeight[i] += 2;
        done = false;
      }
      const x = i * 60 + axisOffset + 10;
      const y =200-currentHeight[i];
      ctx.fillStyle = ‘hsl(‘ + (i * 60) + ', 70%, 50%)';
      ctx.fillRect(x, y, barWidth, currentHeight[i]);
    }

    if (tickProgress < 1) tickProgress = Math.min(1, tickProgress + 0.02);
    if (!done || tickProgress < 1) requestAnimationFrame(animate);
  }
  animate();

  document.getElementById('benchChart').onmousemove = function (evt) {
    const rect=this.getBoundingClientRect();
    const x=evt.clientX-rect.left;
    const y=evt.clientY-rect.top;
	⁃	    for(let i=0;i<data.length;i++){
	⁃	      const barX=i*60+axisOffset+10;
	⁃	      const barHeight=currentHeight[i];
      const barY=200-barHeight;
	⁃	      if(x>=barX && x<=barX+barWidth && y>=barY){
	⁃	        tooltip.style.display='block';
	⁃	        tooltip.style.left=evt.clientX+5 +';
	⁃	        tooltip.style.top= evt.clientY - 20 +';
	⁃	        tooltip.innerText=data[i]+' ms';
	⁃	        return;
	⁃	      }
	⁃	    }
	⁃	    tooltip.style.display =‘none’u;
	⁃	  }
	⁃	}
	⁃	</script>
