4. GitHub Actions Siri Workflow Updates
	⁃	Scheduled Action now decrypts report and audit log.

jobs:
  siri-decrypt:
    ...
    steps:
      - name: Decrypt Audit Log
        run: |
          python3 - <<'PY'
          import json, base64
          from cryptography.fernet import Fernet

          with open('active_keys.json') as f:
              keys = json.load(f)
          latest_key = base64.b64decode(keys[-1]['key'])

          # Decrypt audit log
          enc_log = "$(ls siri_key_access_log.json.enc | sort | tail -1)"
          with open(enc_log, 'rb') as f:
              encrypted = f.read()
          fernet = Fernet(latest_key)
          decrypted = fernet.decrypt(encrypted)
          with open("decrypted_audit_log.json", "wb") as f:
              f.write(decrypted)
          PY

