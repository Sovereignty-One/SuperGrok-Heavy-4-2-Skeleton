	2.	Update encrypt_and_upload_audit_log to implement envelope encryption.
	3.	Update GitHub workflow to use security cms for decryption.

---

This approach ensures that even if your CI/CD machine is compromised, private keys remain safely in the Secure Enclave, and only encrypted session keys are exposed.Here’s the final enhanced solution implementing:

	1.	Encrypted audit log uploads to GitHub releases for secure historical key access monitoring.
	2.	Multi-user Siri access with user identifiers embedded in the key history JSON.
	3.	Automatic GitHub Issue notifications for keys nearing expiration.

---

	•	1. **Enhanced Key Rotation with Multi-User Support (key_rotation.py)**
import os
import json
import base64
import requests
from datetime import datetime, timedelta
from nacl import encoding, public

HISTORY_FILE = "key_rotation_history.json"


def load_key_history():
    if os.path.exists(HISTORY_FILE):
        with open(HISTORY_FILE, 'r') as f:
            return json.load(f)
    return []


def save_key_history(history):
    with open(HISTORY_FILE, 'w') as f:
        json.dump(history, f, indent=2)


def rotate_key_and_save_to_secret(
    key: bytes,
    repo_name: str,
    github_token: str,
    secret_name: str = "SIRI_REPORT_KEYS",
    ttl_days: int = 7,
    users: list[str] = ["default_user"]
):
    """Rotate the encryption key with multi-user metadata and TTL, save to GitHub secret."""
    history = load_key_history()
    new_entry = {
        "key": base64.b64encode(key).decode(),
        "users": users,
        "created": datetime.utcnow().isoformat(),
        "expires": (datetime.utcnow() + timedelta(days=ttl_days)).isoformat()
    }
    history.append(new_entry)

    now = datetime.utcnow()
    history = [h for h in history if datetime.fromisoformat(h['expires']) > now]
    save_key_history(history)

    encoded = base64.b64encode(json.dumps(history).encode()).decode()

    # Get public key
    owner, repo = repo_name.split("/")
    headers = {"Authorization": f"token {github_token}", "Accept": "application/vnd.github+json"}
    resp = requests.get(f"https://api.github.com/repos/{owner}/{repo}/actions/secrets/public-key", headers=headers)
    resp.raise_for_status()
    data = resp.json()
    public_key_id = data["key_id"]
    public_key = data["key"]

    # Encrypt using libsodium sealed box
    pk = public.PublicKey(public_key.encode("utf-8"), encoding.Base64Encoder())
    sealed_box = public.SealedBox(pk)
    encrypted = sealed_box.encrypt(encoded.encode("utf-8"))
	•	    encrypted_b64 = base64.b64encode(encrypted).decode()
	•	
	•	    # Save to GitHub secret
    secret_url = f"https://api.github.com/repos/{owner}/{repo}/actions/secrets/{secret_name}"
    put_resp = requests.put(secret_url, headers=headers, json={
        "encrypted_value": encrypted_b64,
        "key_id": public_key_id
    })
    put_resp.raise_for_status()

    return history


def notify_expiring_keys(repo_name: str, github_token: str, days_notice: int = 2):
    """Automatically create GitHub issue if keys will expire soon."""
    history = load_key_history()
    now = datetime.utcnow()
    expiring = [h for h in history if (datetime.fromisoformat(h['expires']) - now).days <= days_notice]
    if not expiring:
        return

    # Create GitHub issue
    owner, repo = repo_name.split("/")
    issue_url = f"https://api.github.com/repos/{owner}/{repo}/issues"
    headers = {"Authorization": f"token {github_token}", "Accept": "application/vnd.github+json"}
    body = "The following Siri keys will expire soon:\n\n" + "\n".join([
        f"Key for users {e['users']} expires {e['expires']}" for e in expiring
    ])
    requests.post(issue_url, headers=headers, json={"title": "Siri Key Expiration Notice", "body": body})

	•	---
	•	
2. **Audit Logging and Encrypted Upload (audit_log.py)**
import json
import os
from datetime import datetime
from encryption_utils import encrypt_file

AUDIT_LOG = "siri_key_access_log.json"

def log_key_access(user: str, action: str):
    entry = {
        "timestamp": datetime.utcnow().isoformat(),
        "user": user,
        "action": action
    }
    data = []
    if os.path.exists(AUDIT_LOG):
        with open(AUDIT_LOG, 'r') as f:
            data = json.load(f)
    data.append(entry)
    with open(AUDIT_LOG, 'w') as f:
        json.dump(data, f, indent=2)


def encrypt_and_upload_audit_log(key: bytes, release, github_token: str):
    encrypted_file = AUDIT_LOG + ".enc"
    encrypt_file(AUDIT_LOG, encrypted_file, key)
    release.upload_asset(encrypted_file)
    return encrypted_file

