{
  "name": "supergrok-unified",
  "version": "13.1.0",
  "description": "SuperGrok Enterprise -- Unified Server",
  "main": "Unified_Server.js",
  "scripts": {
    "start":   "node Unified_Server.js",
    "dev":     "VERBOSE=1 node Unified_Server.js",
    "shell":   "ALLOW_SHELL=1 node Unified_Server.js",
    "check":   "node --check Unified_Server.js && echo OK",
    "keygen":  "node -e \"const k=require('crypto').randomBytes(64);require('fs').writeFileSync('.sg_master_key',k,{mode:0o600});console.log('MASTER_KEY_B64='+k.toString('base64'));\""
  },
  "engines": { "node": ">=18.0.0" },
  "dependencies": { "ws": "^8.18.0" }
}
